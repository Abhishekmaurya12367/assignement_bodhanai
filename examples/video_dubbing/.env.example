# Bodhan model keys (one key per model; create in https://console.bodhan.ai)
BODHAN_TRANSCRIBE_KEY=your_indic_transcribe_key
BODHAN_TRANSLATE_KEY=your_indic_translate_key
BODHAN_SPEAK_KEY=your_indic_speak_key
# Optional stretch goal
# BODHAN_OCR_KEY=your_indic_ocr_key

# Bodhan API base (no trailing slash). /v1 routes are OpenAI-compatible;
# /translate is a plain JSON endpoint on the same host.
BODHAN_API_BASE=https://api.bodhan.ai

# OpenAI-compatible LLM (English-side decisions only — never writes Indic text)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key

# Optional tuning
# BODHAN_MAX_CONCURRENCY=4
# BODHAN_REQUEST_TIMEOUT_S=120
# BODHAN_CACHE_DIR=.cache
